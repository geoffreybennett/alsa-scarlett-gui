state.Forte {
	control.1 {
		iface PCM
		name 'Playback Channel Map'
		value.0 3
		value.1 4
		value.2 7
		value.3 8
		comment {
			access 'read volatile'
			type INTEGER
			count 4
			range '0 - 36'
		}
	}
