<component type="desktop-application">
  <id>vu.b4.alsa-scarlett-gui</id>

  <name>ALSA Scarlett Control Panel</name>
  <summary>Control Focusrite USB audio interfaces</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      ALSA Scarlett Control Panel configures supported Focusrite Scarlett,
      Clarett, and Vocaster USB audio interfaces on Linux. It provides a
      graphical interface for the controls exposed by the Linux kernel ALSA
      drivers.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Audio routing and matrix mixing</li>
      <li>Input, output, and monitoring controls</li>
      <li>Custom port names, stereo linking, and device presets</li>
      <li>Level meters and DSP controls on supported interfaces</li>
      <li>Firmware updates for supported devices</li>
    </ul>
  </description>

  <launchable type="desktop-id">vu.b4.alsa-scarlett-gui.desktop</launchable>

  <developer id="vu.b4">
    <name>Geoffrey D. Bennett</name>
  </developer>

  <url type="homepage">https://github.com/geoffreybennett/alsa-scarlett-gui</url>
